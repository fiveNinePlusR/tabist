{

    "description": "Quick Tab Switcher",
    "manifest_version": 3,
    "name": "Tabist Private",
    "version": "0.1.9",
    "homepage_url": "https://github.com/fiveNinePlusR/tabist",
    "icons": {
        "48": "icons/page-48_white.png"
    },

    "permissions": [
      "tabs",
      "storage",
      "downloads",
      "sidePanel"
    ],

  "background": {
      "persistant": false,
      "scripts": ["lib/js/background.js"],
      "service_worker": "lib/js/background.js",
      "type": "module"
  },

  "action": {
      "default_icon": "icons/page-32_white.png"
  },

  "side_panel": {
    "default_icon": "icons/page-32_white.png",
    "default_title" : "Tabist",
    "default_path": "tabs.html",
    "open_at_install": false
  },

  "commands": {
      "toggle-tabist": {
          "suggested_key": {
              "default": "Ctrl+Shift+E",
              "mac": "Ctrl+Shift+E",
              "windows": "Ctrl+Shift+E"
          },
          "description": "Toggle or activate a Tabist tab"
      },
      "_execute_sidebar_action": {
          "suggested_key": {
              "default": "Ctrl+Shift+Z",
              "mac": "Ctrl+Shift+S",
              "windows": "Ctrl+Shift+Z"
          },
          "description": "Toggle or activate a Tabist sidebar"
      }
  }
}

